#!/bin/bash

# Function to calculate CPU usage
get_cpu_usage() {
    # Get the average CPU usage over 1 second
    cpu_idle=$(top -bn1 | grep "Cpu(s)" | awk '{print $8}' | cut -d'.' -f1)
    cpu_usage=$((100 - cpu_idle))
    echo $cpu_usage
}

# Function to calculate memory usage
get_memory_usage() {
    # Get memory usage percentage
    mem_usage=$(free | grep Mem | awk '{print $3/$2 * 100.0}' | cut -d'.' -f1)
    echo $mem_usage
}

# Function to calculate disk usage
get_disk_usage() {
    # Get disk usage percentage for root partition
    disk_usage=$(df / | grep / | awk '{print $5}' | sed 's/%//g')
    echo $disk_usage
}

# Analyze health
cpu_usage=$(get_cpu_usage)
mem_usage=$(get_memory_usage)
disk_usage=$(get_disk_usage)

health_status="Healthy"
explanation=""

if [ $cpu_usage -gt 60 ]; then
    health_status="Not Healthy"
    explanation+="CPU usage is high ($cpu_usage%). "
fi

if [ $mem_usage -gt 60 ]; then
    health_status="Not Healthy"
    explanation+="Memory usage is high ($mem_usage%). "
fi

if [ $disk_usage -gt 60 ]; then
    health_status="Not Healthy"
    explanation+="Disk usage is high ($disk_usage%). "
fi

# Print health status
echo "VM Health Status: $health_status"

# If --explain argument is passed, provide explanation
if [ "$1" == "--explain" ]; then
    if [ "$explanation" == "" ]; then
        explanation="All parameters are within healthy limits."
    fi
    echo "Explanation: $explanation"
fi
